# Server-only. Leave blank to use the rule-based recommendation fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
STUDIO_LLM_TIMEOUT_MS=8000

# Required on a shared preview before anyone can edit prices.
# Leave blank in local development to allow admin on APP_ENV=development.
STUDIO_ADMIN_CODE=

# Isolated studio database. Never point this at a production database.
APP_ENV=development
STUDIO_DB_PATH=
